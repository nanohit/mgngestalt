{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/cabinet",
      "destination": "/cabinet.html"
    },
    {
      "source": "/therapist/:id",
      "destination": "/therapist.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' https://cdn.jsdelivr.net https://fastly.jsdelivr.net; style-src 'self' https://cdn.jsdelivr.net https://fastly.jsdelivr.net; img-src 'self' data: blob: https://cdn.jsdelivr.net https://fastly.jsdelivr.net https://i.ibb.co https://uwcvheonmfsibqtcfosw.supabase.co; connect-src 'self' https://cdn.jsdelivr.net https://fastly.jsdelivr.net https://uwcvheonmfsibqtcfosw.supabase.co; font-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/1",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/1/:path*",
      "destination": "/:path*",
      "permanent": true
    }
  ]
}
